/* No Sensitive Data Stored Here */

#users
username = ["CJ", "KZ", "QP"]

#firewall
sg_name = "tf_firewall"
sg_inbound_rules = {
  "internal_admin" = { port = 8080, protocol = "tcp", cidr = "0.0.0.0/0" }
  "https"          = { port = 443, protocol = "tcp", cidr = "0.0.0.0/0" }
  "SSH"            = { port = 22, protocol = "tcp", cidr = "114.125.101.201/32" }
}


#ec2Instance
env           = "prod"
instance_name = ["Box-01", "Box-02"]
ami_id = {
  "us-east-1"  = "ami-08a0d1e16fc3f61ea",
  "us-west-2"  = "ami-0b20a6f09484773af",
  "ap-south-2" = "ami-0e1d06225679bc1c5"
}
instance_type = "m5.large"
region        = "us-east-1"
